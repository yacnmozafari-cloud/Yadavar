<script>
/* =====================================================================
   یادآور چادرملو — بخش ۴ از ۴: زنگ، حالت شب، اعلان‌ها، تنظیمات و PWA
   مجتمع معدنی و صنعتی چادرملو · طراحی و توسعه: یاسین مظفری
   ===================================================================== */
'use strict';

const WEB = /^https?:$/.test(location.protocol);
const STANDALONE = matchMedia('(display-mode: standalone)').matches;
const MODE = STANDALONE ? 'برنامه نصب‌شده (PWA)' : WEB ? 'مرورگر (قابل نصب)' : 'فایل HTML روی گوشی';
let REG = null;     // Service Worker
let INSTALL = null; // پیشنهاد نصب Chrome

// ================= اعلان‌ها =================
async function notify(kind, id, title, body, opts = {}) {
  if (!('Notification' in window) || Notification.permission !== 'granted') return;
  const o = {
    body, tag: kind + '-' + id, renotify: true, dir: 'rtl', lang: 'fa', icon: 'icon-192.png',
    data: { kind, id }, silent: !!opts.silent, requireInteraction: !!opts.ring
  };
  if (opts.ring) o.vibrate = [900, 500, 900, 500, 900];
  try {
    if (REG) { if (opts.actions && opts.actions.length) o.actions = opts.actions; await REG.showNotification(title, o); }
    else new Notification(title, o);
  } catch (_) {}
}
async function clearNotif(kind, id) {
  if (!REG) return;
  try { (await REG.getNotifications({ tag: kind + '-' + id })).forEach(n => n.close()); } catch (_) {}
}

// یادآوری بدون زنگ: اعلان + صدای کوتاه
function remind(n) {
  notify('note', n.id, '📝 ' + (n.title || 'یادآوری کار'), (n.text || 'زمان انجام این کار رسیده است').slice(0, 200), {
    actions: [{ action: 'done', title: '✓ انجام شد' }, { action: 'later', title: '۱۰ دقیقه بعد' }]
  });
  Sound.chime();
  toast('📝 یادآوری: ' + (n.title || n.text || 'یادداشت').slice(0, 50), 6000);
}

// خلاصه روزانه کارهای انجام‌نشده
function digest() {
  const now = Date.now(), undone = D.notes.filter(n => !n.done);
  if (!undone.length) return;
  const late = undone.filter(n => n.at && n.at < now).length;
  notify('digest', 0, fa(undone.length) + ' کار انجام‌نشده' + (late ? ' (' + fa(late) + ' عقب‌افتاده)' : ''),
    undone.slice(0, 5).map(n => '• ' + (n.title || n.text || 'بدون عنوان').slice(0, 50)).join('\n'));
}

// کلیک روی اعلان یا دکمه‌های آن (از sw.js یا از آدرس صفحه)
async function handleNotif(m) {
  const id = +m.id, isRinging = ringing && ringing.kind === m.kind && ringing.id === id;
  if (m.kind === 'digest') { UI.tab = 'notes'; UI.filter = 'undone'; return render(); }
  const item = findItem(m.kind, id);
  if (!item) return;
  if (m.action === 'snooze' || m.action === 'later') {
    if (isRinging) { if (!R.snooze) R.snooze = 10; return ACT.ringSnooze(); }
    item.sn = Date.now() + (m.kind === 'alarm' ? item.snooze || 5 : 10) * MIN;
    await save(); render();
    return toast('زنگ ' + rel(item.sn) + ' دوباره پخش می‌شود');
  }
  if (m.action === 'done' && m.kind === 'note') {
    setDone(item, true); await save(); render();
    return toast('✓ انجام شد');
  }
  if (isRinging) return;
  if (m.kind === 'note') { UI.tab = 'notes'; render(); editNote(id); }
  else { UI.tab = 'alarms'; render(); }
}

// ================= صفحه زنگ و معمای ریاضی =================
const R = { kind: null, id: 0, level: 0, left: 0, total: 0, snooze: 0, p: null };

function showRing(kind, item) {
  const isA = kind === 'alarm';
  Object.assign(R, { kind, id: item.id, level: isA ? item.level : D.settings.pzNote, snooze: isA ? item.snooze : 10 });
  R.total = R.left = R.level < 0 ? 0 : isA ? item.count || 1 : 1;
  drawRing();
  if (!$('#ring').classList.contains('show')) { $('#ring').classList.add('show'); Back.push('ring', ringBack); }
  Wake.set('ring', true);
  Sound.ring(isA ? item.tone : 'bell', isA ? item.grad : false).then(ok => {
    const t = $('#rTap');
    if (!ok && t) t.innerHTML = '<button class="btn acc w mt" data-act="ringPlay">🔊 برای پخش صدای زنگ لمس کنید</button>';
  });
  if (!isA || item.vib) Sound.vibrate(true);
  notify(kind, item.id, isA ? '⏰ ' + (item.label || 'زنگ بیدارباش') : '📝 ' + (item.title || 'یادآوری کار'),
    isA ? 'برای خاموش کردن، برنامه را باز کنید و معما را حل کنید' : (item.text || 'زمان انجام این کار رسیده است').slice(0, 200),
    { ring: true, actions: R.snooze ? [{ action: isA ? 'snooze' : 'later', title: '😴 ' + fa(R.snooze) + ' دقیقه بعد' }] : [] });
}

function drawRing() {
  const item = findItem(R.kind, R.id);
  if (!item) return;
  const isA = R.kind === 'alarm', atts = isA ? [] : item.atts || [];
  const img = atts.find(a => a.type === 'image');
  $('#ringBody').innerHTML = `<div class="sub">${isA ? '⏰ هشدار' : '📝 یادآوری'} · ${jDate(Date.now(), true)}</div>
    <div class="rt" id="rTime" dir="ltr">${hm(Date.now())}</div>
    <div class="rtitle">${esc(isA ? item.label || 'زنگ بیدارباش' : item.title || 'یادآوری کار')}</div>
    ${!isA && item.text ? `<div class="rtext">${esc(item.text.slice(0, 300))}</div>` : ''}
    ${img ? `<img data-file="${img.key}" alt="" style="max-width:100%;max-height:28vh;border-radius:14px;margin-top:8px">` : ''}
    ${atts.length ? `<div class="sub">${fa(atts.length)} پیوست · بعد از خاموش کردن زنگ، یادداشت باز می‌شود</div>` : ''}
    <div id="rTap"></div>
    ${puzzleHTML()}
    ${R.snooze ? `<div class="btns"><button class="btn ghost" data-act="ringSnooze">😴 ${fa(R.snooze)} دقیقه دیگر</button></div>` : ''}
    <div class="sub mt">مجتمع معدنی و صنعتی چادرملو</div>`;
  hydrate($('#ringBody'));
}

function puzzleHTML() {
  if (R.left <= 0) return '<div class="puz"><button class="btn acc w" data-act="ringOff">خاموش کردن زنگ</button></div>';
  R.p = Puzzle.make(R.level);
  return `<div class="puz" id="puz">
    <div class="sub">برای خاموش کردن زنگ، معما را حل کنید${R.total > 1 ? ` (${fa(R.total - R.left + 1)} از ${fa(R.total)})` : ''}</div>
    <div class="pe" dir="ltr">${fa(R.p.q)} = ?</div>
    <input id="pans" inputmode="numeric" autocomplete="off" placeholder="جواب">
    <button class="btn acc w" data-act="ringCheck">تأیید</button></div>`;
}

function shake() {
  const b = $('#ringBody');
  b.classList.remove('shake');
  void b.offsetWidth;
  b.classList.add('shake');
}
function ringBack() { Back.push('ring', ringBack); shake(); toast('برای خاموش کردن زنگ، معما را حل کنید'); }

ACT.ringCheck = () => {
  const inp = $('#pans');
  if (!inp || !R.p) return;
  if (!en(inp.value).replace(/[^\d]/g, '')) { shake(); return toast('اول جواب را وارد کنید'); }
  if (!Puzzle.check(R.p, inp.value)) { shake(); toast('اشتباه بود؛ این معمای تازه را حل کنید'); $('#puz').outerHTML = puzzleHTML(); return; }
  R.left--;
  if (R.left > 0) { $('#puz').outerHTML = puzzleHTML(); toast('درست بود ✓ یکی دیگر'); }
  else { toast('✓ زنگ خاموش شد'); stopRing(true); }
};
document.addEventListener('keydown', e => { if (e.key === 'Enter' && e.target.id === 'pans') ACT.ringCheck(); });

ACT.ringOff = () => stopRing(true);
ACT.ringPlay = () => {
  const it = findItem(R.kind, R.id);
  if (it) Sound.ring(R.kind === 'alarm' ? it.tone : 'bell', false);
  $('#rTap').innerHTML = '';
};
ACT.ringSnooze = async () => {
  const item = findItem(R.kind, R.id);
  if (item && R.snooze) {
    item.sn = Date.now() + R.snooze * MIN;
    await save();
    toast('زنگ ' + fa(R.snooze) + ' دقیقه دیگر دوباره پخش می‌شود');
  }
  stopRing(false);
};

function stopRing(open) {
  const kind = R.kind, id = R.id, item = findItem(kind, id);
  Sound.stop();
  clearNotif(kind, id);
  R.kind = null;
  if (item && item.test) { D.alarms = D.alarms.filter(a => a !== item); save(); }
  if (Q.length) { nextRing(); if (ringing) return; }
  ringing = null;
  $('#ring').classList.remove('show');
  Wake.set('ring', false);
  Back.pop('ring');
  render();
  if (open && kind === 'note' && item) setTimeout(() => editNote(id), 350);
}

// ================= حالت شب =================
ACT.night = async () => {
  const ok = await Sound.guard(true);
  D.settings.guard = true;
  save();
  if (!$('#night').classList.contains('show')) {
    $('#night').classList.add('show');
    Back.push('night', () => nightOff(false));
  }
  Wake.set('night', true);
  uiTick();
  banners();
  toast(ok ? 'حالت شب روشن شد. گوشی را به شارژ بزنید؛ می‌توانید صفحه را خاموش کنید'
    : 'پخش صدای پس‌زمینه ممکن نشد؛ صفحه را روشن نگه دارید', 6000);
};
function nightOff(pop) {
  $('#night').classList.remove('show');
  Wake.set('night', false);
  Sound.guard(false);
  D.settings.guard = false;
  save();
  banners();
  if (pop) Back.pop('night');
  toast('حالت شب خاموش شد');
}
ACT.nightOff = () => nightOff(true);

// ================= ساعت بالای صفحه و به‌روزرسانی‌ها =================
let lastMin = -1;
function uiTick() {
  const now = Date.now(), d = new Date(now);
  $('#clk').innerHTML = fa(two(d.getHours()) + ':' + two(d.getMinutes())) + '<small>:' + fa(two(d.getSeconds())) + '</small>';
  if (d.getMinutes() !== lastMin) {
    lastMin = d.getMinutes();
    $('#today').textContent = jDate(now, true) + ' · ' + gDate(now);
    if (UI.tab !== 'more' && !(document.activeElement && document.activeElement.id === 'nq')) render();
  }
  if ($('#night').classList.contains('show')) {
    const up = upcoming()[0];
    $('#nc').textContent = fa(two(d.getHours()) + ':' + two(d.getMinutes()));
    $('#nd').textContent = jDate(now, true);
    $('#nn').textContent = up ? '⏰ زنگ بعدی ' + hm(up.t) + ' · ' + span(up.t - now) + ' دیگر' : 'هیچ هشدار فعالی ندارید';
  }
  const rt = $('#rTime');
  if (rt && R.kind) rt.textContent = hm(now);
}

// ================= پیام‌های بالای صفحه =================
function banners() {
  const b = [];
  if (!STORE_OK) b.push('⚠️ حافظه مرورگر در دسترس نیست و اطلاعات ذخیره نمی‌شود. برنامه را با Chrome یا از آدرس اینترنتی آن باز کنید.');
  if ('Notification' in window && Notification.permission === 'default' && (D.alarms.length || D.notes.length)) {
    b.push('🔔 برای دیدن یادآوری‌ها در نوار اعلان گوشی <button class="chip" data-act="askNotif">اجازه اعلان بدهید</button>');
  }
  if (D.settings.guard && !Sound.guardOn) {
    b.push('🌙 حالت شب قطع شده است و زنگ صبح ممکن است پخش نشود. <button class="chip" data-act="night">روشن کردن دوباره</button>');
  }
  $('#banners').innerHTML = b.map(x => `<div class="banner">${x}</div>`).join('');
}
ACT.askNotif = async () => {
  try { await Notification.requestPermission(); } catch (_) {}
  render();
};

// ================= تب «بیشتر» =================
const LOGO = s => `<svg width="${s}" height="${s}" viewBox="0 0 512 512" aria-hidden="true">
  <rect width="512" height="512" rx="110" fill="#0d3b66"/>
  <path d="M0 420 150 250 260 360 360 230 512 410V512H0Z" fill="#1a5a8f"/>
  <path d="M0 470 120 400 250 450 400 390 512 440V512H0Z" fill="#8a3f22"/>
  <circle cx="180" cy="130" r="34" fill="#e8772e"/><circle cx="332" cy="130" r="34" fill="#e8772e"/>
  <circle cx="256" cy="236" r="118" fill="#e8772e"/><circle cx="256" cy="236" r="96" fill="#fff"/>
  <path d="M256 168V236L302 262" stroke="#0d3b66" stroke-width="16" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
  <circle cx="256" cy="236" r="12" fill="#0d3b66"/></svg>`;

function drawIcon(c, s) {
  const x = c.getContext('2d');
  x.setTransform(s / 512, 0, 0, s / 512, 0, 0);
  x.fillStyle = '#0d3b66'; x.fillRect(0, 0, 512, 512);
  const poly = (pts, col) => { x.fillStyle = col; x.beginPath(); pts.forEach(([a, b], i) => (i ? x.lineTo(a, b) : x.moveTo(a, b))); x.closePath(); x.fill(); };
  const dot = (cx, cy, r, col) => { x.fillStyle = col; x.beginPath(); x.arc(cx, cy, r, 0, 7); x.fill(); };
  poly([[0, 420], [150, 250], [260, 360], [360, 230], [512, 410], [512, 512], [0, 512]], '#1a5a8f');
  poly([[0, 470], [120, 400], [250, 450], [400, 390], [512, 440], [512, 512], [0, 512]], '#8a3f22');
  dot(180, 130, 34, '#e8772e'); dot(332, 130, 34, '#e8772e');
  dot(256, 236, 118, '#e8772e'); dot(256, 236, 96, '#fff');
  x.strokeStyle = '#0d3b66'; x.lineWidth = 16; x.lineCap = 'round'; x.lineJoin = 'round';
  x.beginPath(); x.moveTo(256, 168); x.lineTo(256, 236); x.lineTo(302, 262); x.stroke();
  dot(256, 236, 12, '#0d3b66');
}

function renderMore(v) {
  const s = D.settings, perm = 'Notification' in window ? Notification.permission : 'none';
  const permTxt = { granted: '✅ فعال', denied: '⛔ مسدود؛ از تنظیمات Chrome فعال کنید', default: 'هنوز اجازه داده نشده', none: 'پشتیبانی نمی‌شود' }[perm];
  v.innerHTML = `
    ${INSTALL ? `<div class="card hero"><div class="row"><div class="grow"><b>نصب یادآور چادرملو روی گوشی</b>
      <div class="sub">با آیکون اختصاصی و اجرای بدون اینترنت</div></div><button class="btn" data-act="install">📲 نصب</button></div></div>` : ''}
    <div class="card"><h4>وضعیت برنامه</h4>
      <div class="tg"><span>اعلان‌ها</span><span class="sub">${permTxt}</span></div>
      ${perm === 'default' ? '<button class="btn w mt" data-act="askNotif">🔔 اجازه نمایش اعلان</button>' : ''}
      <div class="tg"><span>نوع اجرا</span><span class="sub">${MODE}</span></div>
      <div class="tg"><span>حافظه</span><span class="sub" id="stInfo">…</span></div>
      <button class="btn ghost w mt" data-act="testRing">🔔 زنگ آزمایشی (۱۵ ثانیه دیگر)</button></div>
    <div class="card"><h4>تنظیمات</h4>
      <label class="tg"><span>خلاصه روزانه کارهای انجام‌نشده</span>
        <span class="sw"><input type="checkbox" data-chg="digestOn" ${s.digest ? 'checked' : ''}><span></span></span></label>
      <div class="tg"><span>ساعت خلاصه روزانه</span>
        <input type="time" dir="ltr" data-chg="digestTime" value="${two(s.dH)}:${two(s.dM)}" style="width:auto"></div>
      <div class="f"><label class="l">معما برای خاموش کردن زنگ یادداشت‌ها</label><div class="seg">${[[-1, 'بدون معما'], [0, 'آسان'], [1, 'متوسط'], [2, 'سخت']]
        .map(([x, t]) => `<button type="button" data-act="pzNote" data-v="${x}" class="${s.pzNote === x ? 'on' : ''}">${t}</button>`).join('')}</div></div></div>
    <div class="card"><h4>پشتیبان‌گیری</h4>
      <div class="sub">همه هشدارها و یادداشت‌ها با عکس، ویدیو و صدا در یک فایل در پوشه Download گوشی ذخیره می‌شوند. بعد از تعویض گوشی یا پاک شدن مرورگر، با «بازیابی» برمی‌گردند.</div>
      <div class="btns"><button class="btn" data-act="backup">💾 پشتیبان‌گیری</button><button class="btn ghost" data-act="restore">♻️ بازیابی</button></div></div>
    <div class="card"><h4>آیکون برنامه (برای نصب PWA)</h4>
      <div class="sub">دو فایل icon-192.png و icon-512.png ساخته می‌شود؛ آن‌ها را کنار index.html در گیت‌هاب آپلود کنید.</div>
      <div class="row mt"><canvas id="icoPrev" width="72" height="72" style="border-radius:16px;flex:none"></canvas>
        <button class="btn grow" data-act="icons">🎨 ساخت آیکون‌های برنامه</button></div></div>
    <div class="card about">${LOGO(64)}<b>یادآور چادرملو</b>
      <div class="sub">هشدار بیدارباش و یادآوری کارهای انجام‌نشده</div>
      <div>مجتمع معدنی و صنعتی چادرملو</div><div class="sub">استان یزد</div>
      <div class="by"><b>طراحی و توسعه: یاسین مظفری</b></div>
      <div class="sub">نسخه ${fa('1.0')}</div></div>`;
  drawIcon($('#icoPrev'), 72);
  storageInfo();
}

async function storageInfo() {
  const el = $('#stInfo');
  if (!el) return;
  let t = STORE_OK ? 'داخل گوشی' : 'در دسترس نیست';
  try {
    const e = await navigator.storage.estimate();
    t = sizeText(e.usage || 0) + ' استفاده‌شده';
    if (await navigator.storage.persisted()) t += ' · ماندگار ✅';
  } catch (_) {}
  el.textContent = t;
}

CHG.digestOn = el => { D.settings.digest = el.checked; save(); syncPeriodic(); };
CHG.digestTime = el => {
  const [h, m] = (el.value || '').split(':').map(Number);
  if (isNaN(h) || isNaN(m)) return;
  D.settings.dH = h; D.settings.dM = m;
  save();
  toast('خلاصه روزانه ساعت ' + hmOf(h, m) + ' نمایش داده می‌شود');
};
ACT.pzNote = el => { D.settings.pzNote = +el.dataset.v; save(); render(); };

ACT.testRing = async () => {
  D.alarms = D.alarms.filter(a => !a.test);
  const t = Date.now() + 15000, d = new Date(t);
  D.alarms.push({
    id: newId(), test: true, h: d.getHours(), m: d.getMinutes(), label: 'زنگ آزمایشی', days: 0, on: true,
    vib: true, tone: 'mine', snooze: 0, level: 0, count: 1, grad: false, skipHol: false, nx: t, sn: 0
  });
  await save();
  toast('زنگ آزمایشی ۱۵ ثانیه دیگر پخش می‌شود. می‌توانید صفحه را قفل کنید', 5000);
};

ACT.backup = async () => {
  toast('در حال آماده‌سازی پشتیبان…');
  try { const n = await backup(); toast('پشتیبان در پوشه Download ذخیره شد (' + n + ' فایل)', 5000); }
  catch (e) { toast('پشتیبان‌گیری انجام نشد؛ شاید حافظه گوشی کم است'); }
};
ACT.restore = () => $('#restoreIn').click();
$('#restoreIn').onchange = async e => {
  const f = e.target.files[0];
  e.target.value = '';
  if (!f || !confirm('اطلاعات فعلی با فایل پشتیبان جایگزین شود؟')) return;
  try { toast('در حال بازیابی…'); await restore(f); render(); toast('بازیابی انجام شد ✓'); }
  catch (err) { toast(err instanceof SyntaxError ? 'فایل پشتیبان معتبر نیست' : 'بازیابی نشد: ' + err.message, 5000); }
};

ACT.icons = () => {
  [192, 512].forEach((s, i) => setTimeout(() => {
    const c = document.createElement('canvas');
    c.width = c.height = s;
    drawIcon(c, s);
    c.toBlob(b => download(b, `icon-${s}.png`), 'image/png');
  }, i * 900));
  toast('icon-192.png و icon-512.png در پوشه Download ذخیره می‌شوند', 5000);
};

addEventListener('beforeinstallprompt', e => { e.preventDefault(); INSTALL = e; if (UI.tab === 'more') render(); });
addEventListener('appinstalled', () => { INSTALL = null; toast('برنامه روی گوشی نصب شد ✓'); render(); });
ACT.install = async () => {
  if (!INSTALL) return;
  INSTALL.prompt();
  try { await INSTALL.userChoice; } catch (_) {}
  INSTALL = null;
  render();
};

// ================= PWA: اجرای آفلاین، اعلان، اشتراک‌گذاری =================
async function setupPWA() {
  if (!WEB) return;
  if (!$('link[rel="manifest"]')) document.head.insertAdjacentHTML('beforeend', '<link rel="manifest" href="manifest.json">');
  if (!('serviceWorker' in navigator)) return;
  navigator.serviceWorker.addEventListener('message', e => { if (e.data && e.data.type === 'notif') handleNotif(e.data); });
  try {
    REG = await navigator.serviceWorker.register('sw.js');
    REG = await navigator.serviceWorker.ready;
  } catch (e) { REG = null; }
  if (navigator.storage && navigator.storage.persist) navigator.storage.persist().catch(() => {});
  syncPeriodic();
}

// خلاصه دوره‌ای حتی وقتی برنامه بسته است (فقط نسخه نصب‌شده)
async function syncPeriodic() {
  try {
    if (!REG || !('periodicSync' in REG)) return;
    if (!D.settings.digest) return await REG.periodicSync.unregister('digest');
    const st = await navigator.permissions.query({ name: 'periodic-background-sync' });
    if (st.state === 'granted') await REG.periodicSync.register('digest', { minInterval: 12 * HOUR });
  } catch (_) {}
}

// فایل‌هایی که از منوی «اشتراک‌گذاری» گوشی فرستاده شده‌اند به یادداشت جدید تبدیل می‌شوند
async function importShare() {
  if (!('caches' in window)) return;
  const cache = await caches.open('yadavar-share');
  const r = await cache.match(new URL('__share/meta', location.href).href);
  if (!r) return;
  let last = 0;
  for (const it of await r.json()) {
    const atts = [];
    for (const f of it.files || []) {
      const res = await cache.match(f.key);
      if (!res) continue;
      const b = await res.blob(), type = (f.type || b.type || '').split('/')[0];
      if (!['image', 'video', 'audio'].includes(type)) continue;
      atts.push({ type, key: await putFile(b), name: f.name || type, size: b.size });
    }
    if (!atts.length && !it.title && !it.text) continue;
    const n = { id: newId(), title: String(it.title || '').slice(0, 100), text: it.text || '', created: Date.now(),
      at: null, ring: true, done: false, pri: 1, atts };
    D.notes.push(n);
    last = n.id;
  }
  await caches.delete('yadavar-share');
  if (last) {
    await save();
    UI.tab = 'notes';
    render();
    editNote(last);
    toast('فایل‌ها به یادداشت جدید اضافه شد؛ زمان یادآوری را تعیین کنید', 5000);
  }
}

async function handleURL() {
  const p = new URLSearchParams(location.search);
  if (!location.search) return;
  history.replaceState(null, '', location.pathname);
  if (p.get('share')) await importShare();
  if (p.get('notif')) await handleNotif({ kind: p.get('notif'), id: p.get('id'), action: p.get('action') || 'open' });
  if (p.get('new') === 'alarm') { UI.tab = 'alarms'; render(); editAlarm(); }
  if (p.get('new') === 'note') { UI.tab = 'notes'; render(); editNote(); }
}

// ================= شروع برنامه =================
document.addEventListener('visibilitychange', () => {
  if (document.visibilityState !== 'visible') return;
  tick(); uiTick(); banners();
});

(async () => {
  await load();
  render();
  uiTick();
  setupPWA();
  await handleURL();
  cleanFiles();
  tick();
  setInterval(() => { tick(); uiTick(); }, 1000);
})();
</script>
